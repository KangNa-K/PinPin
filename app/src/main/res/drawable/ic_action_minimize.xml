<?xml version="1.0" encoding="utf-8"?>
<!--
  "Minimize to ball" affordance. Two SEPARATE stroke-only arrows
  pointing INWARD at the center, with a deliberate 2-unit gap
  between their arrowheads so they don't merge into a single
  shape at small icon sizes.

  Geometry:
    Arrow 1: starts at the top-left corner (5,5), shaft ends at
             (10,10), and the head's two strokes (10,10)→(10,6)
             and (10,10)→(6,10) wrap back to the shaft. The
             arrowhead is therefore 2 units in from the icon's
             geometric center (12,12).
    Arrow 2: mirror of arrow 1 across the diagonal: starts at
             (19,19), shaft ends at (14,14), with head strokes
             (14,14)→(14,18) and (14,14)→(18,14).

  The resulting 2×√2 ≈ 2.83-unit gap between the two arrowheads
  keeps each arrow visually distinct while still reading as
  "collapse inward".

  Why stroke instead of fill: the earlier Material `unfold_less`
  filled glyph, even when rotated 45°, merged the two chevrons
  into a solid "+" silhouette on the actual toolbar tint.
  Switching to thin strokes keeps the chevron shape readable and
  unambiguously reads as "two arrows pointing in", not "plus".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Top-left → near center: shaft ends 2 units before center -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M5,5 L10,10 M10,10 L10,6 M10,10 L6,10" />
    <!-- Bottom-right → near center: shaft ends 2 units before center -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M19,19 L14,14 M14,14 L14,18 M14,14 L18,14" />
</vector>
