<!--
    M3 tonal-surface background for the pin toolbar.

    M3 specifies the toolbar should sit on `surfaceContainer` (light:
    #F0F0F4, dark: #2A2A3E). We use the dark-theme equivalent with
    ~95% opacity so it reads as a solid floating surface on any
    underlying app — same translucency rationale as
    [bg_close_button]. Rounded corners use M3 "extra-large" shape
    (28dp), which gives the pill a friendly, M3-compliant feel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2292D3D" />
    <corners android:radius="28dp" />
</shape>