<!--
    1dp × 24dp vertical divider for between toolbar action groups.

    M3 dividers use `outlineVariant` (≈ 12% white-on-dark). Hard-coded
    here for the same overlay-attr-limits reason as
    [bg_toolbar] / [bg_close_button].
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1FFFFFFF" />
    <size
        android:width="1dp"
        android:height="24dp" />
</shape>