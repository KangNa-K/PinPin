<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Durable images referenced by PinEntity rows. -->
    <files-path name="pin_assets" path="pin_assets/" />
    <!-- History thumbnails may be shared by future history actions. -->
    <files-path name="screenshot_history" path="screenshot_history/" />
