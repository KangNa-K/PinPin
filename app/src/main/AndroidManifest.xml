<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Floating window permission: required to draw overlays on top of other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service: keep the overlay alive when the app is not in foreground. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ requires the matching type permission for the declared service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notification permission: required on Android 13+ to show the foreground service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PinApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_original"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_original"
        android:supportsRtl="true"
        android:theme="@style/Theme.PinPin">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PinPin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Receive shared images from other apps (gallery, browser,
                WeChat, ...). The view model pulls the URI and inserts a
                new pin via PinRepository.
            -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!--
            First-launch wizard. Renders 4 steps (welcome, notification,
            overlay, accessibility) and starts the ball service when
            everything is granted.
        -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.PinPin" />

        <!--
            Foreground service that owns the WindowManager and holds the floating
            pin views. foregroundServiceType is "specialUse" — this is the only
            type that a third-party app can declare for a user-visible overlay
            use case. (mediaProjection requires user-initiated capture flows
            and is a different type of FGS; we keep it separate for now to
            avoid the type-mismatch that Android 14+ throws when the manifest
            type and the startForeground() type disagree.)

            Subtype property describes the specialUse reason; the matching
            FOREGROUND_SERVICE_SPECIAL_USE permission is declared above.
        -->
        <service
            android:name=".overlay.PinOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:configChanges="uiMode">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_pinned_image_overlay" />
        </service>

        <!--
            Foreground service that owns the persistent floating ball
            and the transient full-screen selection overlay. Same FGS
            type as the pin overlay service because both are
            user-visible overlays.
        -->
        <service
            android:name=".ball.BallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_selection_ball" />
        </service>

        <!--
            Image-adjust preview screen launched after the user picks
            a new floating-ball image. The activity is a top-level
            window so the user sees the image at full size and the
            "what you see is what you get" circular preview is
            unambiguous. The result Intent carries the picked URI and
            the (scale, offsetX, offsetY) the user picked, which
            HomeScreen forwards to BallService.setBallImage.
        -->
        <activity
            android:name=".ball.BallImageAdjustActivity"
            android:exported="false"
            android:theme="@style/Theme.PinPin" />

        <!--
            Accessibility service that owns the screen-capture path. The
            XML service configuration requests only the screenshot capability;
            this app does not retrieve window content or inspect accessibility
            events.
        -->
        <service
            android:name=".a11y.PinAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pin_a11y_config" />
        </service>

        <!--
            FileProvider for sharing pin images. Pin assets are
            saved as file:// URIs in private app storage; Android
            7.0+ forbids sharing file:// URIs with other apps.
            The provider converts them to content:// URIs that
            grant temporary read access to the target app.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
